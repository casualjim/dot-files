#!/usr/bin/env python3
import pathlib
import subprocess
import sys
import tempfile


def main():
    if sys.platform != 'linux':
        print('Dotfiles updater is supported only on Linux.', file=sys.stderr)
        return 1
    repo = pathlib.Path(__file__).resolve().parents[2]
    with tempfile.TemporaryDirectory(prefix="dotfiles-update-") as directory:
        status = pathlib.Path(directory) / "status"
        child = """
import pathlib, subprocess, sys
try:
    code = subprocess.call(['mise', '-C', sys.argv[1], 'run', 'update'])
except OSError as error:
    print(error, flush=True)
    code = 1
pathlib.Path(sys.argv[2]).write_text(str(code))
print(f'Update finished with exit status {code}. Press Enter to close.', flush=True)
try:
    input()
except EOFError:
    pass
sys.exit(code)
"""
        subprocess.run([
            "ghostty", "--gtk-single-instance=false", "--title=System updates",
            "-e", sys.executable, "-c", child, str(repo), str(status),
        ], check=False)
        if not status.exists():
            print("Update terminal closed before reporting completion.", file=sys.stderr)
            return 1
        code = int(status.read_text())
        if code:
            print(f"mise run update failed with exit status {code}.", file=sys.stderr)
        return code if code > 0 else (1 if code else 0)


if __name__ == "__main__":
    sys.exit(main())
