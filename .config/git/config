# Shared git config, tracked in the dotfiles repo. Git reads this first and ~/.gitconfig after it,
# so ~/.gitconfig (untracked: name, email, signing key, whatever `git config --global` or gh writes)
# can override anything here. Restored whole from the old repo; only the identity moved out.

[user]
	useConfigOnly = true
[core]
	excludesfile = $HOME/.gitignore_global
	pager = delta
[alias]
	st = status
	ci = commit
	co = checkout
	br = branch
	up = push
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative --remotes=origin
	patch = --no-pager diff --no-color
	dft = difftool
	dlog = "!f() { GIT_EXTERNAL_DIFF=difft git log -p --ext-diff $@; }; f"
[color]
	diff = auto
	status = auto
	branch = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[mirror]
	summary = true
[filter "media"]
	clean = git-media-clean %f
	smudge = git-media-smudge %f
# [credential]
	# helper = osxkeychain
	# helper = /usr/lib/git-core/git-credential-libsecret
	;helper = kwallet
	;helper = /usr/libexec/git-core/git-credential-libsecret
	;helper = /usr/share/doc/git/contrib/credential/libsecret/git-credential-libsecret
[diff]
	tool = difftastic
	# external = difft
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true
[help]
	autocorrect = 1
[fetch]
	prune = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[pull]
	rebase = false
[commit]
	gpgsign = false
	;template = /Users/ivan/.stCommitMsg
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[http "https://pkg.re"]
	followRedirects = true
[gpg]
	program = gpg
	format = openpgp
[protocol]
	version = 2

[delta]
	# syntax-theme = Visual Studio Dark+
	syntax-theme = Catppuccin-mocha
	# features = decorations
	# features = diff-so-fancy

[interactive]
	diffFilter = delta --color-only --features=interactive

[delta "interactive"]
	keep-plus-minus-markers = false



[init]
	defaultBranch = main

[safe]
	directory = /workspace
[tag]
	forceSignAnnotated = false
[gpg "ssh"]
	program = ssh-keygen
	allowedSignersFile = ""

# GitHub through the gh CLI. The empty helper line clears any inherited helper first.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Per-OS bits (macOS: osxkeychain; Linux: the Gitea helper). Only created where mise writes it;
# a missing file is ignored.
[include]
	path = ~/.config/git/os.gitconfig
