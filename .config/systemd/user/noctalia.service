[Unit]
Description=Noctalia Wayland shell
PartOf=graphical-session.target
After=niri.service

[Service]
Type=notify
ExecStart=/usr/bin/noctalia
Environment="PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin"
Restart=on-failure
Slice=session.slice

[Install]
WantedBy=graphical-session.target
