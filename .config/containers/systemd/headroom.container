# Headroom, a local proxy. A Quadlet: podman turns this into headroom.service (systemctl --user status headroom).
# Loopback only; the container listens on 8787 and the host port is 8788.
[Unit]
Description=Headroom proxy

[Quadlet]
DefaultDependencies=false

[Container]
Image=ghcr.io/headroomlabs-ai/headroom
# Only a label: podman-auto-update.timer (enabled in mise.linux.toml) pulls a newer image and restarts the unit.
AutoUpdate=registry
ContainerName=headroom
PublishPort=127.0.0.1:8788:8787
Environment=HEADROOM_HOST=0.0.0.0
Environment=HEADROOM_PORT=8787
# The host publishes this container port on loopback only.
Environment=HEADROOM_ALLOW_UNAUTHENTICATED_BIND=1
Environment=HEADROOM_TELEMETRY=off
Environment=HEADROOM_SAVINGS_PATH=/data/proxy_savings.json
Volume=%h/.local/state/headroom:/data
Exec=--host 0.0.0.0 --port 8787 --no-cache

[Service]
Restart=always
# The unit is Type=notify, so it stays "starting" until the container is up, and the first start pulls the
# image. The default 90 s start timeout can kill a slow pull.
TimeoutStartSec=900

[Install]
WantedBy=default.target
