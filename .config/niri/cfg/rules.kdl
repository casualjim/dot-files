    window-rule {
        geometry-corner-radius 20 // Set every window radius to 20
        clip-to-geometry true
    }

    window-rule {
        background-effect {
          blur true
          xray false
        }
    }

    // Floating Noctalia settings window.
    window-rule {
        match app-id="dev.noctalia.Noctalia"
        open-floating true
        default-column-width { fixed 1080; }
        default-window-height { fixed 920; }
    }

    // if you use steam you will probably like these
    window-rule {
        match app-id="steam"
        exclude title=r#"^[Ss]team$"#
        open-floating true
    }

    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }

    layer-rule {
        match namespace="^noctalia-wallpaper"
        place-within-backdrop true
    }

    layer-rule {
        match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
        background-effect {
          xray false
          // blur false
        }
    }

    // Chrome is only for streaming (see the managed policy in system/etc/opt/chrome): second monitor (the Dell),
    // one full-width column.
    window-rule {
        match app-id="^google-chrome"
        open-on-output "Dell Inc. DELL P2715Q V7WP959M053L"
        default-column-width { proportion 1.0; }
    }

    window-rule {
        match app-id=r#"^so\.stencil\.tern$"#
        default-column-width { proportion 1.0; }
    }

    // Messengers and the authenticator open as half-width columns. niri has no rule to open a window inside
    // an existing column, so stack two by hand with consume-or-expel-window-left/right.
    window-rule {
        match app-id="^signal$"
        match app-id="^zapzap$"
        match app-id="^TelegramDesktop$"
        match app-id="^authenticator$"
        default-column-width { proportion 0.5; }
    }

    // Proton Mail (which includes Calendar) and Proton Drive live on the second workspace of the first monitor (the LG).
    window-rule {
        match app-id="proton-mail"
        match app-id="proton-drive"
        match app-id="pdfs"
        match app-id="narl"
        open-on-workspace "mail"
    }
